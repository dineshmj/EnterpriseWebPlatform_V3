################################################################################
# EnterpriseWebPlatform V3
# Visual Studio / .NET / Node.js / generated artifacts
################################################################################

# -------------------------------------------------------------------------------
# Visual Studio
# -------------------------------------------------------------------------------

.vs/

# Visual Studio user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# -------------------------------------------------------------------------------
# .NET build output
# -------------------------------------------------------------------------------

**/bin/
**/obj/

# -------------------------------------------------------------------------------
# ASP.NET Core / IdentityServer development artifacts
# -------------------------------------------------------------------------------

# IdentityServer developer signing key / private key material
**/tempkey*.jwk
**/keys/
# SEC: certificates with their private keys stay in %USERPROFILE%\.aspnet\https, never here
# (a dev certificate key was committed once - found by SonarQube Cloud, 28-OCT-2026).
*.pfx
*.p12
*.key
**/certs/

# -------------------------------------------------------------------------------
# Node.js / Next.js
# -------------------------------------------------------------------------------

**/node_modules/
**/.next/
**/dist/

# Next.js generated static assets
**/wwwroot/_next/

# -------------------------------------------------------------------------------
# Environment files
# -------------------------------------------------------------------------------

# V3 is a local PoC. Environment files are intentionally version-controlled
# so the complete development configuration can be restored on another VDI.
#
# DO NOT ignore:
#   .env
#   .env.local
#   .env.development
#   .env.development.local
#   .env.test
#   .env.test.local
#
# These may contain PoC-only credentials, URLs, ports, Kafka settings, etc.

# -------------------------------------------------------------------------------
# Logs
# -------------------------------------------------------------------------------

*.log

# -------------------------------------------------------------------------------
# OS generated files
# -------------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# -------------------------------------------------------------------------------
# Generated project documentation
# -------------------------------------------------------------------------------

/CodeHierarchy.md
*.zip
/smartzipper.exclude.json

# Generated static exports (CompileAndExport) and TypeScript build caches - never committed.
# src/IDP/wwwroot is hand-written source and stays tracked.
**/client-app/out/
src/Shell/wwwroot/
src/Microservices/*/BFF.Web/wwwroot/
**/tsconfig.tsbuildinfo

# Terraform working files (the cloud demo; state lives in Azure, never here).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# Playwright run state when it is started from the repository root (the suite lives in tst/playwright)
/test-results/