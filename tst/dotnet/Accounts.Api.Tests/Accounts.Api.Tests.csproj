<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>EnterpriseWebPlatform.Accounts.Api.Tests</RootNamespace>
    <AssemblyName>EnterpriseWebPlatform.Accounts.Api.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Microservices\Accounts\API\EnterpriseWebPlatform.Accounts.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup>
    <!-- BIAN's published contract (doc/bian), checked against the /v2 mapping (Bian/). -->
    <None Include="..\..\..\doc\bian\release14.0.0\CurrentAccount.yaml" Link="Bian\CurrentAccount.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Shared\BianSchema.cs" Link="Shared\BianSchema.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- External systems played by WireMock.Net (Infrastructure/): started and stopped per test. -->
    <Compile Include="..\Shared\WireMockNeighbour.cs" Link="Shared\WireMockNeighbour.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="WireMock.Net" Version="2.21.0" />
    <!-- ARCH: Humanizer.Core 3 referenced directly - Flagd needs >= 3 (via JsonPointer.Net), WireMock.Net pins exactly 2.14.1;
         without this, NuGet cannot settle it (NU1107). Remove when WireMock.Net moves to Humanizer 3. -->
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>