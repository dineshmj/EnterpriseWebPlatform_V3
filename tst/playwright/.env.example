# Copy to .env (git-ignored) and fill in the demo users' passwords - never commit .env.
#
# EWP_PASSWORD_DEFAULT is used for every demo user that has no line of its own below.
# A user's own line wins, e.g. EWP_PASSWORD_ETHAN_KYC for ethan.kyc (dots become underscores).
EWP_PASSWORD_DEFAULT=

# EWP_PASSWORD_SOPHIE_CS=
# EWP_PASSWORD_MIA_CS=
# EWP_PASSWORD_ETHAN_KYC=
# EWP_PASSWORD_LIAM_KYC=
# EWP_PASSWORD_NOAH_KYC=
# EWP_PASSWORD_GRACE_COMPLIANCE=
# EWP_PASSWORD_OLIVIA_COMPLIANCE=
# EWP_PASSWORD_JACK_ACCOUNTS=
# EWP_PASSWORD_EMILY_PAYMENTS=
# EWP_PASSWORD_DANIEL_OPS=
# EWP_PASSWORD_SARAH_AUDIT=

# A saved sign-in is reused for this many minutes (the BFF sessions slide for 30).
EWP_SESSION_REUSE_MINUTES=20

# MFA tests (tests\40-security\mfa): true only while MFA is switched on (tst\README.md, MFA tests).
EWP_MFA_ENABLED=false
# Must equal the step-up age set for the run (Mfa:StepUpMaxAgeMinutes, OPERATIONS_MFA_MAX_AGE_MINUTES).
EWP_STEP_UP_MAX_AGE_MINUTES=1

# Audit tamper test (tests\40-security\audit\audit-tamper-evidence): the PostgreSQL superuser's password
# (the same one Reset.ps1 uses) - the test plays a database administrator editing the trail. Empty = skipped.
EWP_POSTGRES_PASSWORD=
# Optional: psql.exe when it is not at C:\Program Files\PostgreSQL\18\bin\psql.exe.
EWP_PSQL_PATH=

# Digital Gold deviation runs (tests\35-resilience\partner-products): true STOPS AND STARTS Kafka and the
# Partner Products Worker on this PC (needs EWP_POSTGRES_PASSWORD too). Anything else = skipped.
EWP_DEVIATION_RUNS=false
# Optional: temporal.exe when it is neither on the PATH's winget link nor in winget's package folder.
EWP_TEMPORAL_PATH=