{
  // ┌─ :: SECURITY :: Development settings: host filtering and secrets ──────────────────────────────
  // │ Why : Requests for other host names could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only the Shell's own host name; the OIDC client key paths and the
  // │       database password here are DEVELOPMENT values - elsewhere they come from the environment
  // │       or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "shell.dev.localhost;localhost",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Duende": "Information"
    }
  },

  "//Secrets": "DEVELOPMENT-ONLY secrets. Outside Development supply them from the environment (ConnectionStrings__MenuDbConnection, ConnectionStrings__BffStateDbConnection, Oidc__ClientKey__Path and Oidc__ClientKey__PasswordPath (mounted files)) or a secret store.",
  "ConnectionStrings": {
    "MenuDbConnection": "Host=localhost;Port=5432;Database=EwpBssShellDb;Username=ewp_shell;Password=ewp-shell-dev",
    "BffStateDbConnection": "Host=localhost;Port=5432;Database=EwpBffStateDb;Username=ewp_shell;Password=ewp-shell-dev"
  },
  "Oidc": {
    "//ClientKey": "DEVELOPMENT: this BFF's private_key_jwt key, made by ps/pki/New-EwpLocalPki.ps1 (outside the repository); elsewhere both files are mounted from a secret store.",
    "ClientKey": {
      "Path": "%USERPROFILE%/.ewp-pki/shell-web-client.key.pem",
      "PasswordPath": "%USERPROFILE%/.ewp-pki/shell-web-client.key.pem.password"
    }
  },
  "//NotificationsApiBaseUrl": "Development: through the fault proxy (route notifications-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls (the bell then reconnects). appsettings.json holds the API's own address, used everywhere else.",
  "NotificationsApiBaseUrl": "https://notifications-api.dev.localhost:47107"
}