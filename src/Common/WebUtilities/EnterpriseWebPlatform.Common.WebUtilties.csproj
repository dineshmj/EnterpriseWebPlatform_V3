<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ASP.NET Core for the shared web defences (rate limiting) used by every BFF and API. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- BFF state (Data Protection keys) in PostgreSQL. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Feature flags (OpenFeature): a flag file read in-process (flagd's file mode) or LaunchDarkly. -->
  <ItemGroup>
    <PackageReference Include="LaunchDarkly.OpenFeature.ServerProvider" Version="2.3.2" />
    <PackageReference Include="LaunchDarkly.ServerSdk" Version="8.17.2" />
    <PackageReference Include="OpenFeature" Version="2.14.1" />
    <PackageReference Include="OpenFeature.Providers.Flagd" Version="0.8.0" />
  </ItemGroup>

</Project>