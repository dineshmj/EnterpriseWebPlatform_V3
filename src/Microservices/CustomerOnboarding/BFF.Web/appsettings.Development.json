{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only customer.dev.localhost (and localhost for health probes);
  // │       passwords, API keys and client secrets in the Development file are DEVELOPMENT values -
  // │       elsewhere they come from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "customer.dev.localhost;localhost",
  "//Secrets": "DEVELOPMENT-ONLY secrets. Outside Development supply them from the environment (Oidc__ClientSecret) or a secret store.",
  "Oidc": {
    "ClientSecret": "68fdf186-0157-4759-a633-441c5f5ac942"
  },
  "CustomerOnboardingBff": {
    "//CustomerOnboardingApiBaseUrl": "Development: through the fault proxy (route customer-onboarding-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls. appsettings.json holds the API's own address, used everywhere else.",
    "CustomerOnboardingApiBaseUrl": "https://customer-api.dev.localhost:47101",
    "//DocumentsManagementApiBaseUrl": "Development: through the fault proxy (route documents-management-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls. appsettings.json holds the API's own address, used everywhere else.",
    "DocumentsManagementApiBaseUrl": "https://documents-management-api.dev.localhost:47103"
  }
