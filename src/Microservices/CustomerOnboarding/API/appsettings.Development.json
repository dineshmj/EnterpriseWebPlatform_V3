{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only customer-api.dev.localhost (and localhost for health probes);
  // │       passwords, API keys and client secrets in the Development file are DEVELOPMENT values -
  // │       elsewhere they come from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "customer-api.dev.localhost;localhost",
  "ConnectionStrings": {
    "CustomerDbConnection": "Host=localhost;Port=5432;Database=EwpCustomerDb;Username=ewp_customer_onboarding_api;Password=ewp-co-api-dev"
  },
  // ┌─ SEC ────────────────────────────────────────────────────────────────────────────────
  // │ DEVELOPMENT keys of crypto-shredding (base64 of 32 random bytes each). MasterKey wraps
  // │ every customer's data key; BlindIndexKey keys the exact-match lookups. Elsewhere both
  // │ come from Key Vault (PersonalData__MasterKey, PersonalData__BlindIndexKey). Changing
  // │ either makes the existing customers unreadable - re-create EwpCustomerDb if you do.
  // └──────────────────────────────────────────────────────────────────────────────────────
  "PersonalData": {
    "MasterKey": "J7iQOwcUxEdAqedFZirArS8sL89QhNqgsACefAnPYsA=",
    "BlindIndexKey": "WclQdhNyEJJ+B7oTeMaPjv6n1fKxMOAN3/2+rC0Tldo="
  },
  "Authentication": {
    // ┌─ SEC ────────────────────────────────────────────────────────────────────────────────
    // │ Development only: Bruno (API testing) cannot sign DPoP proofs, so ITS person tokens
    // │ may stay Bearer here. Everywhere else the list is empty: every token without cnf is
    // │ refused, and so is the Bearer scheme itself (Program.cs).
    // └──────────────────────────────────────────────────────────────────────────────────────
    "BearerPersonTokenClients": [ "BSS.ApiTesting.Bruno.ClientID" ],
    "Authority": "https://idp.dev.localhost:46392",
    "Audience": "customer-onboarding-api"
  },
  // ┌─ ARCH ───────────────────────────────────────────────────────────────────────────────
  // │ Development only: short ages, so a stopped subscriber or simulator shows on Platform
  // │ Health within minutes.
  // └──────────────────────────────────────────────────────────────────────────────────────
  "Onboarding": {
    "//Alerts": "Development: short ages so a stopped subscriber or simulator shows on Platform Health within minutes.",
    "Alerts": {
      "HandoverMinutes": 5,
      "OfficerDecisionMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "//FeatureFlags": "DEVELOPMENT: the repository's flag file (feature-flags/README.md), re-read every 5 s. EWP_LAUNCHDARKLY_SDK_KEY in the environment wins over it (LaunchDarkly). Neither = every flag keeps its default.",
  "FeatureFlags": {
    "File": "../../../../feature-flags/ewp-flags.json"
  }
}