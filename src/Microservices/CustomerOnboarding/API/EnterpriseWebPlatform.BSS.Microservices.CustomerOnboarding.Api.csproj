<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>EnterpriseWebPlatform.BSS.Microservices.CustomerOnboarding.Api</RootNamespace>
    <AssemblyName>EnterpriseWebPlatform.BSS.Microservices.CustomerOnboarding.Api</AssemblyName>

    <!-- WHY:
         This is a single-project microservice. API, Application, Domain and
         Infrastructure are architectural folders within the same deployable
         ASP.NET Core project rather than separate projects. -->

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />

    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />

    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\WebUtilities\EnterpriseWebPlatform.Common.WebUtilties.csproj" />
    <ProjectReference Include="..\..\..\Common\Observability\EnterpriseWebPlatform.Common.Observability.csproj" />
  </ItemGroup>

</Project>