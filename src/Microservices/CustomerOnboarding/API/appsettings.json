  // ┌─ ARCH ───────────────────────────────────────────────────────────────────────────────
  // │ Production alert ages: machine steps 15 min, officer steps one day. Too short floods
  // │ operations with false alarms; too long hides a stopped hand-off. Both are required -
  // │ no start without them.
  // └──────────────────────────────────────────────────────────────────────────────────────
  "Onboarding": {
    "//Alerts": "Readiness turns Degraded when an onboarding application waits longer than this in one step: machine steps (a subscriber, Kafka, the Outbox relay) after HandoverMinutes, officer steps (KYC, Compliance, account opening) after OfficerDecisionMinutes; CompensationFailed always. Required, positive.",
    "Alerts": {
      "HandoverMinutes": 15,
      "OfficerDecisionMinutes": 1440
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}