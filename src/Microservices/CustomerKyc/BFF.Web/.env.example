KYC_BFF_PORT=33800
KYC_IDP_AUTHORITY=https://idp.dev.localhost:46392
# Must equal ClientIds:CustomerKycWeb in src\IDP\appsettings.json (where the IDP registers that client).
KYC_BFF_CLIENT_ID=CustomerKYC.Microservice.BFF.ClientID
# private_key_jwt: this BFF's own key (ps\pki\New-EwpLocalPki.ps1 makes it, outside the repository)
KYC_BFF_CLIENT_KEY_PATH=%USERPROFILE%\.ewp-pki\customer-kyc-web-client.key.pem
KYC_BFF_CLIENT_KEY_PASSWORD_PATH=%USERPROFILE%\.ewp-pki\customer-kyc-web-client.key.pem.password
KYC_BFF_CALLBACK_URL=https://kyc.dev.localhost:33800/api/auth/callback
KYC_BFF_POST_LOGOUT_REDIRECT_URI=https://kyc.dev.localhost:33800/signout-callback-oidc
# Development: the API addresses below go through the fault proxy (ps\toxiproxy\toxiproxy.json,
# ports 47101-47111) so operations can cut them; elsewhere use each API's own address.
KYC_API_BASE_URL=https://kyc-api.dev.localhost:47102
KYC_BFF_SESSION_SECRET=replace-with-a-development-only-random-secret

# Sessions in PostgreSQL (EwpBffStateDb, schema kyc_bff), encrypted at rest: 32 random bytes, base64
KYC_BFF_SESSION_KEY=GTnnrDXPQ66oL8MYk1htsvQqduJcKc1/QGGxXs2LdnA=
KYC_BFF_DATABASE_URL=postgres://ewp_kyc_bff:ewp-kyc-bff-dev@localhost:5432/EwpBffStateDb
KYC_BFF_TLS_PFX_PATH=%USERPROFILE%\.aspnet\https\ewp-v3-dev.pfx
KYC_BFF_TLS_PFX_PASSWORD=dev-password
KYC_BFF_STATIC_ROOT=client-app/out

# Documents Management API (called for the officer by token exchange)
KYC_DOCUMENTS_MANAGEMENT_API_BASE_URL=https://documents-management-api.dev.localhost:47103


# Shell origin allowed to frame this MFE (CSP frame-ancestors)
# Must equal ClientBaseUrls:Shell in src\IDP\appsettings.json and ShellOrigin in the Shell.
KYC_BFF_SHELL_ORIGIN=https://shell.dev.localhost:46367