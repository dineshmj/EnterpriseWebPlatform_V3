{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only payments-api.dev.localhost (and localhost for health probes);
  // │       passwords, API keys and client secrets in the Development file are DEVELOPMENT values -
  // │       elsewhere they come from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "payments-api.dev.localhost;localhost",
  "//Secrets": "DEVELOPMENT-ONLY secrets. Outside Development supply them from the environment (ConnectionStrings__PaymentsDbConnection, Kafka__SaslPassword, PaymentNetwork__ApiKey) or a secret store.",
  "ConnectionStrings": {
    "PaymentsDbConnection": "Host=localhost;Port=5432;Database=EwpPaymentsDb;Username=ewp_payments_api;Password=ewp-payments-api-dev"
  },
  "Kafka": {
    "SaslPassword": "ewp-payments-api-kafka-dev",
    "SslCaLocation": "%USERPROFILE%/.ewp-pki/ewp-trust-root.pem"
  },
  "PaymentNetwork": {
    "ApiKey": "sim-paymentnetwork-key-dev-4b7d"
  },
  "Payments": {
    "Saga": {
      "//": "DEVELOPMENT ONLY: short timeouts, so a failed compensation shows within about a minute (production: appsettings.json).",
      "ReplyTimeoutSeconds": 10,
      "MaxReplyTimeoutSeconds": 60,
      "MaxCommandAttempts": 3,
      "UnconfirmedAlertMinutes": 2
    },
    "Outbox": {
      "//": "DEVELOPMENT ONLY: a message parks after 3 failed attempts (about 2 minutes with Kafka stopped), so the resend can be shown.",
      "MaxAttempts": 3,
      "BaseDelaySeconds": 2
    }
  }
}