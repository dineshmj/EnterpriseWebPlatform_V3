{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only payments.dev.localhost (and localhost for health probes);
  // │       passwords, API keys and key file paths in the Development file are DEVELOPMENT values -
  // │       elsewhere they come from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "payments.dev.localhost;localhost",
  "//Secrets": "DEVELOPMENT-ONLY secrets. Outside Development supply them from the environment (ConnectionStrings__BffStateDbConnection, Oidc__ClientKey__Path and Oidc__ClientKey__PasswordPath (mounted files)) or a secret store.",
  "ConnectionStrings": {
    "BffStateDbConnection": "Host=localhost;Port=5432;Database=EwpBffStateDb;Username=ewp_payments_bff;Password=ewp-payments-bff-dev"
  },
  "Oidc": {
    "//ClientKey": "DEVELOPMENT: this BFF's private_key_jwt key, made by ps/pki/New-EwpLocalPki.ps1 (outside the repository); elsewhere both files are mounted from a secret store.",
    "ClientKey": {
      "Path": "%USERPROFILE%/.ewp-pki/payments-web-client.key.pem",
      "PasswordPath": "%USERPROFILE%/.ewp-pki/payments-web-client.key.pem.password"
    }
  },
  "PaymentsBff": {
    "//PaymentsApiBaseUrl": "Development: through the fault proxy (route payments-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls. appsettings.json holds the API's own address, used everywhere else.",
    "PaymentsApiBaseUrl": "https://payments-api.dev.localhost:47106",
    "//AccountsApiBaseUrl": "Development: through the fault proxy (route accounts-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls. appsettings.json holds the API's own address, used everywhere else.",
    "AccountsApiBaseUrl": "https://accounts-api.dev.localhost:47105"
  }
}