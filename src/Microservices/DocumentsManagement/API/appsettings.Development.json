{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only documents-management-api.dev.localhost (and localhost for health
  // │       probes); passwords, API keys and client secrets in the Development file are DEVELOPMENT
  // │       values - elsewhere they come from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment (the public host name(s), e.g. via the AllowedHosts environment variable).",
  "AllowedHosts": "documents-management-api.dev.localhost;localhost",
  "DocumentStorage": {
    "RootPath": "DocumentStorage",
    "//Encryption": "DEVELOPMENT-ONLY key-encryption key for documents at rest (32 random bytes, Base64). Outside Development supply the keys from a secret store / key vault (DocumentStorage__Encryption__CurrentKeyId, DocumentStorage__Encryption__Keys__<id>). Rotation: add a key, make it current, keep the old one while documents still name it.",
    "Encryption": {
      "CurrentKeyId": "dev-2026-10",
      "Keys": {
        "dev-2026-10": "/HRBmDxh/GimKiwTq1yoyKTBkC+v/4N3nP63HzYXEQE="
      }
    }
  }
