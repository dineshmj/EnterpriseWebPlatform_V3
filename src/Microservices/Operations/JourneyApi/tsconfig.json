{
  // ┌─ :: ARCHITECTURE :: TypeScript 6 compiler settings ──────────────────────────────────────
  // │ Why : TypeScript 6 deprecates moduleResolution "node" (node10) and baseUrl, defaults
  // │       "types" to none and "rootDir" to this folder - left as they were, the build would
  // │       warn, lose the Node globals and move main.js to dist/src (Dockerfile + start script
  // │       run dist/main.js).
  // │ How : "nodenext" resolves packages the way Node itself does (package.json "exports",
  // │       require conditions; still CommonJS output - package.json has no "type": "module");
  // │       rootDir ./src keeps dist/main.js; types names the Node globals the code uses.
  // └──────────────────────────────────────────────────────────────────────────────────────────
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}