{
  "name": "operations-journey-api",
  "version": "0.1.0",
  "private": true,
  "description": "Operations Journey API (NestJS): platform health for the operations administrator and, in Development, the simulators' behaviour switch.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json --isolatedModules false",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "express": "5.3.0",
    "jose": "4.15.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "jest": {
    "rootDir": ".",
    "roots": ["<rootDir>/test"],
    "testEnvironment": "node",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/test/tsconfig.json"
        }
      ]
    },
    "globalSetup": "<rootDir>/../../../../tst/node/wiremock/wiremock-start.ts",
    "globalTeardown": "<rootDir>/../../../../tst/node/wiremock/wiremock-stop.ts",
    "testTimeout": 20000
  }
}