{
  "name": "partner-products-journey-api",
  "version": "0.1.0",
  "private": true,
  "description": "Partner Products Journey API (NestJS): the counter's Digital Gold journeys (EWP as the Partner Bank's distributor), composing Customer Onboarding, Accounts, Documents Management and the Partner Products Domain API by token exchange.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@temporalio/client": "1.24.0",
    "express": "5.2.1",
    "jose": "4.15.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.7",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.2"
  },
  "jest": {
    "rootDir": "test",
    "testEnvironment": "node",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    },
    "globalSetup": "<rootDir>/../../../../../tst/node/wiremock/wiremock-start.ts",
    "globalTeardown": "<rootDir>/../../../../../tst/node/wiremock/wiremock-stop.ts",
    "testTimeout": 20000
  }
}