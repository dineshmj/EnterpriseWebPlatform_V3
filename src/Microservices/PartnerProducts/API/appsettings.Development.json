{
  // ┌─ :: SECURITY :: Host filtering and where the secrets come from ────────────────────────────────
  // │ Why : A request for another host name could poison generated links; development secrets must
  // │       never reach a deployment.
  // │ How : AllowedHosts serves only partner-products-api.dev.localhost (and localhost for health
  // │       probes); the connection string's password in appsettings.json is a DEVELOPMENT value -
  // │       elsewhere it comes from the environment or a secret store.
  // │ Ref : Features 2.4.5 | OWASP A05 Security Misconfiguration | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//AllowedHosts": "Host filtering: only requests addressed to these host names are served (others get 400). localhost keeps local health probes working. Outside Development set AllowedHosts per deployment.",
  "AllowedHosts": "partner-products-api.dev.localhost;localhost",
  // ┌─ ARCH ───────────────────────────────────────────────────────────────────────────────
  // │ Development only: short alert ages, so a stopped Worker, an unreachable Partner Bank or
  // │ a payment nobody approves shows on Platform Health within minutes.
  // └──────────────────────────────────────────────────────────────────────────────────────
  "DigitalGold": {
    "Alerts": {
      "HandoverMinutes": 5,
      "UnpaidOrderMinutes": 40,
      "PaymentDecisionMinutes": 60
    }
  },
  "//Secrets": "DEVELOPMENT-ONLY secret. Outside Development supply it from the environment (Kafka__SaslPassword) or a secret store.",
  "Kafka": {
    "SaslPassword": "ewp-partner-products-api-kafka-dev",
    "SslCaLocation": "%USERPROFILE%/.ewp-pki/ewp-trust-root.pem"
  },
  "//ConnectionStrings": "DEVELOPMENT-ONLY password. Outside Development: ConnectionStrings__PartnerProductsDbConnection from the environment or a secret store.",
  "ConnectionStrings": {
    "PartnerProductsDbConnection": "Host=localhost;Port=5432;Database=EwpPartnerProductsDb;Username=ewp_partner_products_api;Password=ewp-partner-products-api-dev"
  },
  "//FeatureFlags": "DEVELOPMENT: the repository's flag file (feature-flags/README.md), re-read every 5 s. EWP_LAUNCHDARKLY_SDK_KEY in the environment wins over it (LaunchDarkly). Neither = every flag keeps its default.",
  "FeatureFlags": {
    "File": "../../../../feature-flags/ewp-flags.json"
  }
}