  "//PartnerBank": "EWP as the Partner Bank's distributor: its token endpoint and API on their mutual-TLS ports, EWP's client ID there, and EWP's keys - made by ps\\pki\\New-EwpLocalPki.ps1 in %USERPROFILE%\\.ewp-pki, outside the repository. Outside Development: PermittedHosts lists the Partner Bank's host names.",
  "PartnerBank": {
    "TokenEndpoint": "https://partner-auth.ewp.home.arpa:47411/connect/token",
    "ApiBaseUrl": "https://partner-api.ewp.home.arpa:47403",
    "StaffViewUrl": "https://partner-products.ewp.home.arpa:47402/StaffView",
    "ClientId": "FourWalls.Ewp.PartnerProducts",
    "ClientCertificatePath": "%USERPROFILE%\\.ewp-pki\\ewp-partner-client.pfx",
    "ClientCertificatePasswordPath": "%USERPROFILE%\\.ewp-pki\\ewp-partner-client.pfx.password",
    "SigningCertificatePath": "%USERPROFILE%\\.ewp-pki\\ewp-request-signing.pfx",
    "SigningCertificatePasswordPath": "%USERPROFILE%\\.ewp-pki\\ewp-request-signing.pfx.password",
    "TrustRootPath": "%USERPROFILE%\\.ewp-pki\\ewp-trust-root.cer",
    "PermittedHosts": [ "partner-auth.ewp.home.arpa", "partner-api.ewp.home.arpa", "partner-products.ewp.home.arpa" ],
    "TimeoutSeconds": 15,
    "//Settlement": "The Partner Bank's account that receives the Digital Gold purchases' payments (the payee of every purchase's payment; never typed at the counter).",
    "Settlement": {
      "PayeeName": "Partner Bank Gold Settlement",
      "Bsb": "182-512",
      "AccountNumber": "961234567"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}