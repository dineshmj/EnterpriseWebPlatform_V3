{
  "name": "partner-products-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Partner Products Worker (Temporal, TypeScript SDK): runs the Digital Gold purchase workflow - follows the purchase's payment at EWP Payments, then sends the Partner Bank's payment advice or cancels the unpaid order, with its own machine identity.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.1.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.2"
  },
  "jest": {
    "rootDir": ".",
    "roots": ["<rootDir>/test"],
    "testEnvironment": "node",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/test/tsconfig.json"
        }
      ]
    },
    "testTimeout": 20000
  }
}