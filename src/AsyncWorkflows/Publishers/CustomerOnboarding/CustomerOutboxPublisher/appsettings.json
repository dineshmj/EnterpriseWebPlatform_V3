{
  "//ConnectionStrings": "CustomerDbConnection holds a password, so it is NOT in this file (which goes into the container image): Development reads it from appsettings.Development.json, everywhere else from the environment (ConnectionStrings__CustomerDbConnection) or a secret store. Missing = the relay refuses to start.",
  // ┌─ :: SECURITY :: Least-privilege identities of the relay ───────────────────────────────────────
  // │ Why : A relay that could read customers or write any topic would turn one compromise into a
  // │       platform-wide one.
  // │ How : Its database user may only read and update the Outbox table; its Kafka user may only
  // │       write Customer Onboarding's topics (ACLs); the password comes from Development settings
  // │       or a secret store.
  // │ Ref : Features 2.4.3, 2.4.6 | db/EwpServiceDbUsers.sql | OWASP A01 (least privilege)
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "ScramSha512",
    "SaslUsername": "ewp-co-outbox-relay"
  },
  "Health": {
    "Urls": "http://localhost:5101"
  },
  "CustomerOutboxPublisher": {
    "BatchSize": 50,
    "PollIntervalSeconds": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}