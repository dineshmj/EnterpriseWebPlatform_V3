{
  // ┌─ :: SECURITY :: Development secrets only ──────────────────────────────────────────────────────
  // │ Why : A worker's Kafka password and its keys are full credentials of its identity.
  // │ How : These values are for Development; elsewhere they come from the environment
  // │       (Kafka__SaslPassword) or a secret store (the mounted key files <Section>__ClientKey__Path,
  // │       <Section>__DPoPKey__Path) - one set per worker, never shared.
  // │ Ref : Features 2.4.5, 2.4.6 | OWASP A05 | CWE-798 | Threat-Model R-10
  // └────────────────────────────────────────────────────────────────────────────────────────────────
  "//Secrets": "DEVELOPMENT-ONLY secrets. Outside Development supply them from the environment (Kafka__SaslPassword; ComplianceCaseOpeningSubscriber__ClientKey__Path, ComplianceCaseOpeningSubscriber__DPoPKey__Path and their PasswordPath files, mounted) or a secret store.",
  "Kafka": {
    "SaslPassword": "ewp-compliance-case-opening-kafka-dev",
    "SslCaLocation": "%USERPROFILE%/.ewp-pki/ewp-trust-root.pem"
  },
  "ComplianceCaseOpeningSubscriber": {
    "//TransientRetryMaxDelaySeconds": "DEVELOPMENT: a message waiting for a dependency is retried at least every 10 s (production: 60, appsettings.json), so an API reopened at the fault proxy - or restarted - is used again within seconds and the saga's reply timers are not outrun.",
    "TransientRetryMaxDelaySeconds": 10,
    "//ComplianceApiBaseUrl": "Development: through the fault proxy (route compliance-api, ps/toxiproxy/toxiproxy.json), so operations can cut it on Simulator & Fault Controls. appsettings.json holds the API's own address, used everywhere else.",
    "ComplianceApiBaseUrl": "https://compliance-api.dev.localhost:47104",
    "//ClientKey": "DEVELOPMENT: this worker's private_key_jwt key and the key its tokens are bound to (DPoP), made by ps/pki/New-EwpLocalPki.ps1 (outside the repository); elsewhere both are mounted from a secret store.",
    "ClientKey": {
      "Path": "%USERPROFILE%/.ewp-pki/compliance-case-opening-subscriber-client.key.pem",
      "PasswordPath": "%USERPROFILE%/.ewp-pki/compliance-case-opening-subscriber-client.key.pem.password"
    },
    "DPoPKey": {
      "Path": "%USERPROFILE%/.ewp-pki/compliance-case-opening-subscriber-dpop.key.pem",
      "PasswordPath": "%USERPROFILE%/.ewp-pki/compliance-case-opening-subscriber-dpop.key.pem.password"
    }
  }
