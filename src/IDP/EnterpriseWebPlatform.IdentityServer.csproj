<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Pages\Home\Error.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityServer" Version="8.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Landscape\EnterpriseWebPlatform.Common.Landscape.csproj" />
    <ProjectReference Include="..\Common\Observability\EnterpriseWebPlatform.Common.Observability.csproj" />
  </ItemGroup>

  <!-- The shared design tokens and brand mark (src/Common/DesignSystem) are the single
       source of the look. Copied into wwwroot on every build, so the IDP stays
       independently deployable and serves them itself (CSP 'self'). -->
  <Target Name="CopyDesignSystemAssets" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\Common\DesignSystem\ewp-tokens.css" DestinationFolder="wwwroot\css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\Common\DesignSystem\four-walls-mark.svg" DestinationFolder="wwwroot\res\img" SkipUnchangedFiles="true" />
  </Target>

</Project>
