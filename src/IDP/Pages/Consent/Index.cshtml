@page
@model EnterpriseWebPlatform.IdentityServer.Pages.Consent.Index
@{
    ViewData["Title"] = "Allow access";
}

<section class="card" aria-labelledby="consent-title">
    <header class="card-head">
        @if (Model.View.ClientLogoUrl != null)
        {
            <img class="client-logo" src="@Model.View.ClientLogoUrl" alt="" />
        }
        <p class="eyebrow">Permission request</p>
        <h1 class="card-title" id="consent-title">@Model.View.ClientName</h1>
        <p class="card-lead">is requesting access to your account. Untick anything you do not wish to share.</p>
    </header>

    <partial name="_ValidationSummary" />

    <form asp-page="/Consent/Index">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        @if (Model.View.IdentityScopes.Any())
        {
            <div class="scope-group">
                <h2>Personal information</h2>
                <ul class="scope-list">
                    @foreach (var scope in Model.View.IdentityScopes)
                    {
                        <partial name="_ScopeListItem" model="@scope" />
                    }
                </ul>
            </div>
        }

        @if (Model.View.ApiScopes.Any())
        {
            <div class="scope-group">
                <h2>Application access</h2>
                <ul class="scope-list">
                    @foreach (var scope in Model.View.ApiScopes)
                    {
                        <partial name="_ScopeListItem" model="scope" />
                    }
                </ul>
            </div>
        }

        @if (Model.View.AllowRememberConsent)
        {
            <label class="check">
                <input asp-for="Input.RememberConsent" />
                <span>Remember my decision</span>
            </label>
        }

        <div class="actions-row">
            @* "yes" first: Enter submits with the form's first submit button. *@
            <button name="Input.button" value="yes" class="btn btn-primary" autofocus>Allow</button>
            <button name="Input.button" value="no" class="btn btn-secondary">Don't allow</button>
        </div>

        @if (Model.View.ClientUrl != null)
        {
            <p class="idp-footer">
                About this application: <a href="@Model.View.ClientUrl">@Model.View.ClientName</a>
            </p>
        }
    </form>
</section>