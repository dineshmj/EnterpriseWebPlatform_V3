@using EnterpriseWebPlatform.IdentityServer.Pages.Consent

@model ScopeViewModel

<li class="scope">
    <label class="scope-label" for="scopes_@Model.Value">
        <input class="consent-scopecheck"
               type="checkbox"
               name="Input.ScopesConsented"
               id="scopes_@Model.Value"
               value="@Model.Value"
               checked="@Model.Checked"
               disabled="@Model.Required" />

        @if (Model.Required)
        {
            <input type="hidden"
                   name="Input.ScopesConsented"
                   value="@Model.Value" />
        }

        <span>@Model.DisplayName</span>

        @if (Model.Required)
        {
            <span class="scope-tag">Required</span>
        }
        else if (Model.Emphasize)
        {
            <span class="scope-tag is-emphasis">Sensitive</span>
        }
    </label>

    @if (Model.Description != null)
    {
        <p class="scope-desc">@Model.Description</p>
    }

    @if (Model.Resources?.Any() == true)
    {
        <div class="scope-desc">
            Will be available to these resource servers:
            <ul>
                @foreach (var resource in Model.Resources)
                {
                    <li>@resource.DisplayName</li>
                }
            </ul>
        </div>
    }
</li>
