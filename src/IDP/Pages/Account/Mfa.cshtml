@page
@model EnterpriseWebPlatform.IdentityServer.Pages.Account.MfaModel
@{
    ViewData["Title"] = "Authenticator code";
}

<section class="card" aria-labelledby="mfa-title">
    <header class="card-head">
        <p class="eyebrow">Two-step sign-in</p>
        <h1 class="card-title" id="mfa-title">Enter your code</h1>
        <p class="card-lead">Open <strong>Google Authenticator</strong> and enter the 6-digit code shown for <strong>EWP V3 Demo</strong>.</p>
    </header>

    <partial name="_ValidationSummary" />

    <form method="post" novalidate>
        <div class="field">
            <label asp-for="Code">Code</label>
            <input class="input" asp-for="Code" inputmode="numeric" autocomplete="one-time-code"
                   maxlength="11" placeholder="123456" autocapitalize="none" spellcheck="false" autofocus />
        </div>

        <p class="card-lead">Lost your phone? Enter one of your recovery codes instead.</p>

        <div class="actions">
            <button class="btn btn-primary btn-block">Verify and sign in</button>
            <a class="btn btn-ghost btn-block" asp-page="/Account/Login">Cancel</a>
        </div>
    </form>
</section>