@page
@model EnterpriseWebPlatform.IdentityServer.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="card" aria-labelledby="login-title">
    <header class="card-head">
        <p class="eyebrow">Staff sign-in</p>
        <h1 class="card-title" id="login-title">Welcome back</h1>
        @if (Model.ClientName is not null)
        {
            <p class="card-lead">Sign in to continue to <strong>@Model.ClientName</strong>.</p>
        }
        else
        {
            <p class="card-lead">Sign in with your Four Walls staff account.</p>
        }
    </header>

    <partial name="_ValidationSummary" />

    <form method="post" novalidate>
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="field">
            <label asp-for="Input.Username">Username</label>
            <input class="input" asp-for="Input.Username" placeholder="e.g. sophie.cs"
                   autocomplete="username" autocapitalize="none" spellcheck="false" autofocus />
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input class="input" type="password" asp-for="Input.Password" autocomplete="current-password" />
        </div>

        <label class="check">
            <input asp-for="Input.RememberLogin" />
            <span>Keep me signed in on this device</span>
        </label>

        <div class="actions">
            <button class="btn btn-primary btn-block" name="Input.Button" value="login">
                Sign in
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            <button class="btn btn-ghost btn-block" name="Input.Button" value="cancel">Cancel</button>
        </div>
    </form>
</section>