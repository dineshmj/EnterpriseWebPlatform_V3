      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outgoing calls per second by service",
      "description": "HttpClient calls (other APIs, the IDP, the external systems).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(http_client_request_duration_seconds_count[5m]))",
          "legendFormat": "{{job}}"
