    {
      "id": 13,
      "type": "timeseries",
      "title": "Retries, timeouts and open circuits",
      "description": "Polly events by pipeline: OnRetry, OnTimeout, OnCircuitOpened (a breaker opening means a dependency is failing).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, pipeline_name, event_name) (increase(resilience_polly_strategy_events_total{event_name=~\"OnRetry|OnTimeout|OnCircuitOpened\"}[5m]))",
          "legendFormat": "{{job}} {{pipeline_name}} {{event_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
